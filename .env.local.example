# Frontend configuration. Copy to .env.local (ignored); never commit real secrets.
SITE_URL=http://localhost:3000
MEDUSA_BACKEND_URL=http://localhost:9000
# Generated by the Medusa bootstrap seed. Keep this server-side.
MEDUSA_PUBLISHABLE_KEY=
# Must match backend/.env. Use independent random values of at least 32 characters.
INQUIRY_PROXY_SECRET=
ORDER_ACCESS_SECRET=
# Approved external payment redirect hosts, once a merchant gateway is configured.
PAYMENT_REDIRECT_HOSTS=checkout.paystack.com
