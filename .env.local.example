# Lead magnet email service (Kit, formerly ConvertKit)
#
# To activate the lead magnet form:
#   1. Copy this file to .env.local (which is gitignored)
#   2. Find your API key: https://app.kit.com/account_settings/advanced_settings
#   3. Find your Form ID: open a form in Kit, the URL ends with /forms/{ID}/...
#   4. Paste both below and restart the dev server
#
# If these are not set, the form works in demo mode (returns success but does not deliver).

KIT_API_KEY=
KIT_FORM_ID=

# Production URL — used for canonical links, sitemap, robots.txt, Open Graph
# previews, and JSON-LD structured data.
#
# Local dev: leave blank to use http://localhost:3000 (the fallback in code).
# Production: set this in your Vercel project's Environment Variables to your
# actual deployed URL (e.g. https://your-site.vercel.app, or your custom domain).
# Do NOT include a trailing slash.

SITE_URL=
